# Copy this file to .env and fill in the values. .env is git-ignored.
# This example file is committed, so never put a real key in it.

# Kaggle (step 1: dataset download). kaggle.com -> Settings -> API -> Create New Token.
# Open the downloaded kaggle.json and copy "username" and "key" here.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Language model (step 4 onward). Free tier, no card: console.groq.com -> API Keys.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_SECOND_MODEL=openai/gpt-oss-20b

# Local fallback, free and unlimited, needs Ollama installed (ollama.com).
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_MODEL=llama3.1:8b

# Gmail (step 12). OAuth client file path, not the contents.
GMAIL_CREDENTIALS_PATH=data/credentials.json
